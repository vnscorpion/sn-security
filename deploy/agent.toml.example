# /etc/sn/agent.toml — SN Secure agent config. Mode 0600 (contains agent_key).
# The installer fills [hub] via `sn enroll`; you edit [watch]/[fw] locally.

[hub]
# Leave empty to run standalone (no hub). `sn enroll` fills these in.
url         = ""
agent_id    = ""
agent_key   = ""                 # ed25519 secret seed (hex); never leaves this box
hub_pubkeys = []                 # ["ed25519:..."] — several allowed for rotation
root_pubkeys = []                # offline root key(s) that sign policy changes

[watch]
# Either simple globs + one format:
logs   = ["/var/log/nginx/*access.log", "/var/log/apache2/*access.log"]
format = "combined"              # combined | sn | nginx_json
# ...or per-source definitions (installer prefers these):
# [[watch.sources]]
# glob   = "/var/log/nginx/*access.log"
# format = "sn"

mode         = "observe"         # observe (report only) | enforce (ban). Start in observe.
k            = 5.0               # threshold multiplier over the baseline
min_requests = 120              # never ban below this many requests/cycle
trusted_proxies = ["cloudflare"] # "cloudflare" expands to CF ranges; or list CIDRs
cpu_alert_pct = 85.0              # cpu_high alert when average CPU since the last cycle reaches this %
bot_detection = true            # alert when ONE User-Agent / request shape floods in from many IPs
bot_min_ips = 25                 # ...from at least this many distinct IPs in a cycle
bot_min_requests = 50            # ...making at least this many dynamic requests
bot_surge = 5.0                  # ...and at least this many times its usual volume

[fw]
whitelist = []                   # admin/office CIDRs — only editable here, never remotely
max_bans_per_cycle = 200
web_ports = [80, 443]            # HTTP-derived bans only touch these ports

[hunt]
allowed_roots = ["/home", "/var/www"]
days = 7
max_file_mb = 5
# Second engine: use ClamAV when it is installed ("auto") or never ("off").
clamav = "auto"
clamav_min_ram_mb = 1536         # clamscan loads a >1 GB database: skipped below this much free RAM
clamav_timeout_secs = 1200
# Unchanged files are scanned by ClamAV again after this many days; new and
# changed files every time. A run that runs out of time continues next time.
clamav_rescan_days = 7

[remote]
# The hub decides what this agent does (bans, mode, scans, undo, evidence, ClamAV,
# incident response). Set to false to make this one VPS only report.
hub_orders = true
